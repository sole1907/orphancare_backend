rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registrations: only allows a signed‑in user to create a document at registrations/{uid} where the doc ID matches their own auth.uid
    match /registrations/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow read, update: if request.auth.token.orphanageAdmin == true && request.auth.uid == uid;
    }

    match /orphanages/{id} {
        // SuperAdmins can do everything
        allow read, write: if request.auth.token.superAdmin == true;

        // Any authenticated user can read orphanage profiles
        allow read: if request.auth != null;

        // OrphanageAdmins can update their own orphanage doc
        allow update: if request.auth.token.orphanageAdmin == true &&
                        request.auth.token.orphanageId == id &&
                        request.auth.uid == resource.data.adminUid;
    }


    // Children: orphanageAdmins can read/write their own orphanage's children
    match /children/{childId} {
        allow read: if request.auth != null; 

        allow write: if request.auth != null &&
            request.auth.token.orphanageAdmin == true &&
            request.resource.data.orphanageId == request.auth.token.orphanageId;

        allow update: if request.auth != null &&
            request.auth.token.orphanageAdmin == true &&
            resource.data.orphanageId == request.auth.token.orphanageId;
    }

    match /donors/{donorId} {
      // Donor can read/write their own record only if verified
      allow read, write: if request.auth != null
                         && request.auth.uid == donorId
                         && request.auth.token.email_verified == true;

      // Super admin can read all donor records
      allow read: if request.auth != null
                  && request.auth.token.superAdmin == true;
    }

    // Updates: orphanageAdmins can create, donors can read
    match /updates/{id} {
      allow create: if request.auth.token.orphanageAdmin == true
  && request.resource.data.orphanageId == request.auth.token.orphanageId;
      allow read: if request.auth.token.donor == true;
    }

    // Payments: donors can create, superAdmins & orphanageAdmins can read
    match /payments/{id} {
        allow create: if request.auth.token.donor == true;

        allow read: if (
            request.auth.token.superAdmin == true ||
            request.auth.token.donor == true && request.auth.uid == resource.data.donorId ||
            request.auth.token.orphanageAdmin == true && resource.data.orphanageId == request.auth.token.orphanageId
        );
    }

    match /hobbies/{hobbyId} {
      allow read: if true; // anyone can read
      allow write: if request.auth != null && request.auth.token.superAdmin == true;
    }

    // Donor follows schema
    match /donor_follows/{donorId} {
      // Only the authenticated donor can access their own follows
      allow read, write: if request.auth != null && request.auth.uid == donorId;

      // Children subcollection
      match /children/{childId} {
        allow read, write: if request.auth != null && request.auth.uid == donorId;
      }
    }

  }
}
