{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "functions/src",
    "outDir": "functions/lib",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["functions/src", "functions/src/types"]
}
